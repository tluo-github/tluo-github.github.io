---
import '../styles/global.css';
import { SITE } from '../consts';
import { type Lang, url } from '../i18n';

interface Props {
	title: string;
	description: string;
	lang: Lang;
	type?: 'website' | 'article';
	/** 另一种语言的对应页面（有真正对应的页面时才传） */
	alternates?: Partial<Record<Lang, string>>;
}

const { title, description, lang, type = 'website', alternates } = Astro.props;
const siteTitle = SITE[lang].title;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === siteTitle ? title : `${title} · ${siteTitle}`;
const hreflang = { zh: 'zh-CN', en: 'en' } as const;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={siteTitle} href={new URL(url(lang, '/rss.xml'), Astro.site)} />
<meta name="generator" content={Astro.generator} />
<meta name="color-scheme" content="light" />
<meta name="theme-color" content="#FAF9F6" />
<link rel="canonical" href={canonicalURL} />
{alternates &&
	Object.entries(alternates).map(([l, href]) => (
		<link rel="alternate" hreflang={hreflang[l as Lang]} href={new URL(href!, Astro.site)} />
	))}

<title>{fullTitle}</title>
<meta name="description" content={description} />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL('/avatar.jpg', Astro.site)} />
<meta property="og:locale" content={lang === 'en' ? 'en_US' : 'zh_CN'} />
<meta name="twitter:card" content="summary" />
