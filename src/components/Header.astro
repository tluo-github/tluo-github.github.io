---
import { GITHUB_URL, SITE } from '../consts';
import { type Lang, t, url } from '../i18n';
import HeaderLink from './HeaderLink.astro';
import GitHub from './icons/GitHub.astro';
import Rss from './icons/Rss.astro';

interface Props {
	lang: Lang;
	switchHref: string;
}
const { lang, switchHref } = Astro.props;
const s = t(lang);
---

<header>
	<nav class="container">
		<a class="brand" href={url(lang, '/')}>
			<img src="/avatar.jpg" alt="" width="28" height="28" />
			<span>{SITE[lang].title}</span>
		</a>
		<div class="links">
			<HeaderLink href={url(lang, '/blog')}>{s.posts}</HeaderLink>
			<HeaderLink href={url(lang, '/projects')}>{s.projects}</HeaderLink>
			<HeaderLink href={url(lang, '/about')}>{s.about}</HeaderLink>
			<span class="icons">
				<a href={GITHUB_URL} target="_blank" rel="noopener" aria-label="GitHub"><GitHub /></a>
				<a href={url(lang, '/rss.xml')} aria-label={s.rss}><Rss /></a>
			</span>
			<a class="lang" href={switchHref} hreflang={lang === 'zh' ? 'en' : 'zh-CN'} aria-label={s.switchLabel}>{s.switchTo}</a>
		</div>
	</nav>
</header>
<style>
	header {
		border-bottom: 1px solid var(--border);
	}
	nav {
		height: 64px;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 17px;
		font-weight: 600;
		color: var(--heading);
	}
	.brand img {
		border-radius: 50%;
	}
	.brand:hover {
		color: var(--accent);
	}
	.links {
		display: flex;
		align-items: center;
		gap: 32px;
		height: 100%;
	}
	.icons {
		display: flex;
		gap: 16px;
		margin-left: 8px;
	}
	.icons a {
		display: flex;
		color: var(--muted);
	}
	.icons a:hover {
		color: var(--heading);
	}
	.lang {
		margin-left: -8px;
		padding: 2px 10px;
		font-size: 13px;
		font-weight: 500;
		color: var(--muted);
		border: 1px solid var(--border-strong);
		border-radius: 6px;
	}
	.lang:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
</style>
