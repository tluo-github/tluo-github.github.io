---
import type { HTMLAttributes } from 'astro/types';
import { parseUrl } from '../i18n';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const section = (p: string) => {
	const first = parseUrl(p).path.match(/[^/]+/)?.[0] ?? '';
	return first === 'tags' ? 'blog' : first;
};
const isActive = !!href && section(String(href)) === section(Astro.url.pathname);
---

<a href={href} class:list={[className, { active: isActive }]} {...props}><slot /></a>
<style>
	a {
		height: 100%;
		display: flex;
		align-items: center;
		font-size: 15px;
		color: var(--muted);
	}
	a:hover {
		color: var(--heading);
	}
	a.active {
		color: var(--heading);
		box-shadow: inset 0 -2px 0 var(--accent);
	}
</style>
