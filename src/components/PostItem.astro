---
import { type Lang, t } from '../i18n';
import { type PostRef, postUrl, readingMinutes, summaryOf } from '../lib/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	item: PostRef;
	/** 当前页面的语言 */
	lang: Lang;
	dateFormat?: 'iso' | 'md';
}
const { item, lang, dateFormat = 'iso' } = Astro.props;
const { post, lang: postLang } = item;
const summary = summaryOf(post);
const s = t(lang);
---

<article class="item">
	<h3>
		<a href={postUrl(postLang, post.id)}>{post.data.title}</a>
		{postLang !== lang && <span class="badge">{s.otherLang}</span>}
	</h3>
	{summary && <p class="summary">{summary}</p>}
	<div class="meta">
		<FormattedDate date={post.data.pubDate} format={dateFormat} lang={lang} />
		<span>·</span>
		<span>{s.minutes(readingMinutes(post, postLang))}</span>
		{post.data.tags.length > 0 && <span>·</span>}
		{post.data.tags.map((tag) => <span class="t">{tag}</span>)}
	</div>
</article>
<style>
	.item {
		padding: 22px 0;
		border-bottom: 1px solid var(--border);
	}
	h3 {
		margin: 0;
		font-size: 19px;
		font-weight: 600;
		line-height: 1.5;
	}
	h3 a {
		color: var(--heading);
	}
	h3 a:hover {
		color: var(--accent);
	}
	.badge {
		margin-left: 8px;
		padding: 1px 6px;
		font-size: 12px;
		font-weight: 500;
		vertical-align: 2px;
		color: var(--muted);
		border: 1px solid var(--border-strong);
		border-radius: 4px;
	}
	.summary {
		margin: 6px 0 0;
		font-size: 15px;
		line-height: 1.7;
		color: var(--muted);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.meta {
		margin-top: 8px;
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		font-size: 13px;
		color: var(--faint);
		font-variant-numeric: tabular-nums;
	}
	.t {
		color: var(--muted);
	}
	.t + .t::before {
		content: '·';
		margin-right: 6px;
		color: var(--faint);
	}
</style>
