---
import { LANG_COLORS, type Project } from '../consts';
import { type Lang, t } from '../i18n';

interface Props {
	project: Project;
	lang: Lang;
	compact?: boolean;
}
const { project, lang, compact = false } = Astro.props;
const { name, repo, url, fork } = project;
const desc = project.desc[lang];
const code = project.lang;
const s = t(lang);
const dot = LANG_COLORS[code] ?? '#999';
---

{compact ? (
	<div class="mini">
		<div class="mini-head">
			<a href={url ?? repo} target="_blank" rel="noopener">{name}</a>
			<span class="lang"><i style={`background:${dot}`}></i>{code}</span>
		</div>
		<p>{desc}</p>
	</div>
) : (
	<div class="card">
		<h3>{name}</h3>
		{fork && <div class="fork">{s.forkedFrom} {fork}</div>}
		<p>{desc}</p>
		<div class="foot">
			<span class="lang"><i style={`background:${dot}`}></i>{code}</span>
			<span class="links">
				{url && <a href={url} target="_blank" rel="noopener">{s.website}</a>}
				<a href={repo} target="_blank" rel="noopener">{s.source}</a>
			</span>
		</div>
	</div>
)}
<style>
	.card {
		display: flex;
		flex-direction: column;
		padding: 24px;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 12px;
		transition: border-color var(--ease), transform var(--ease), box-shadow var(--ease);
	}
	.card:hover {
		border-color: var(--border-strong);
		transform: translateY(-2px);
		box-shadow: 0 8px 24px rgba(40, 35, 25, 0.06);
	}
	h3 {
		margin: 0;
		font-size: 18px;
		font-weight: 600;
	}
	.fork {
		margin-top: 2px;
		font-size: 13px;
		color: var(--faint);
	}
	.card p {
		flex: 1;
		margin: 10px 0 20px;
		font-size: 15px;
		line-height: 1.7;
	}
	.foot {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	.lang {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 13px;
		color: var(--muted);
	}
	.lang i {
		width: 10px;
		height: 10px;
		border-radius: 50%;
	}
	.links {
		display: flex;
		gap: 16px;
		font-size: 14px;
	}
	.mini + :global(.mini) {
		margin-top: 18px;
	}
	.mini-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	.mini-head a {
		font-size: 15px;
		font-weight: 600;
		color: var(--heading);
	}
	.mini-head a:hover {
		color: var(--accent);
	}
	.mini .lang {
		font-size: 12px;
	}
	.mini .lang i {
		width: 8px;
		height: 8px;
	}
	.mini p {
		margin: 2px 0 0;
		font-size: 14px;
		line-height: 1.65;
		color: var(--muted);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
