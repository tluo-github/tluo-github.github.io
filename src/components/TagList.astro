---
import type { Lang } from '../i18n';
import { tagUrl } from '../lib/posts';

interface Props {
	tags: [string, number][];
	lang: Lang;
	current?: string;
}
const { tags, lang, current } = Astro.props;
---

<div class="tags">
	{tags.map(([tag, n]) => (
		<a class:list={['tag-chip', { current: tag === current }]} href={tagUrl(lang, tag)}>
			{tag}<span>{n}</span>
		</a>
	))}
</div>
<style>
	.current {
		background: var(--accent);
		color: #fff;
	}
	.current:hover {
		background: var(--accent-hover);
		color: #fff;
	}
</style>
