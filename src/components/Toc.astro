---
import type { MarkdownHeading } from 'astro';

interface Props {
	headings: MarkdownHeading[];
}
const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{items.length >= 3 && (
	<nav class="toc" aria-label="目录">
		<div class="side-title">目录</div>
		<ul>
			{items.map((h) => (
				<li class={`d${h.depth}`}>
					<a href={`#${h.slug}`} data-slug={h.slug}>{h.text}</a>
				</li>
			))}
		</ul>
		<a class="top" href="#">↑ 回到顶部</a>
	</nav>
)}

<script>
	const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a[data-slug]')];
	const targets = links
		.map((a) => document.getElementById(a.dataset.slug!))
		.filter((el): el is HTMLElement => !!el);
	const setActive = (id: string) =>
		links.forEach((a) => a.classList.toggle('active', a.dataset.slug === id));
	const update = () => {
		let current = targets[0];
		for (const el of targets) if (el.getBoundingClientRect().top < 120) current = el;
		if (current) setActive(current.id);
	};
	if (targets.length) {
		addEventListener('scroll', update, { passive: true });
		update();
	}
</script>

<style>
	.toc {
		font-size: 14px;
		line-height: 1.6;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		border-left: 1px solid var(--border);
	}
	li a {
		display: block;
		padding: 4px 0 4px 12px;
		margin-left: -1px;
		border-left: 2px solid transparent;
		color: var(--muted);
	}
	li.d3 a {
		padding-left: 24px;
		font-size: 13.5px;
	}
	li a:hover {
		color: var(--heading);
	}
	li a.active {
		color: var(--accent);
		border-left-color: var(--accent);
	}
	.top {
		display: inline-block;
		margin-top: 16px;
		font-size: 13px;
		color: var(--faint);
	}
	.top:hover {
		color: var(--heading);
	}
</style>
