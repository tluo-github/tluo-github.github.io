---
import type { MarkdownHeading } from 'astro';
import FormattedDate from '../components/FormattedDate.astro';
import Toc from '../components/Toc.astro';
import { type Post, readingMinutes, summaryOf, tagUrl } from '../lib/posts';
import Base from './Base.astro';

interface Props {
	post: Post;
	headings: MarkdownHeading[];
	prev?: Post;
	next?: Post;
}
const { post, headings, prev, next } = Astro.props;
const { title, pubDate, updatedDate, tags } = post.data;
const summary = summaryOf(post);
---

<Base title={title} description={summary ?? title} type="article">
	<div class="layout post">
		<article>
			<header class="post-head">
				<div class="meta">
					<FormattedDate date={pubDate} format="cn" />
					{updatedDate && <span>· 更新于 <FormattedDate date={updatedDate} format="cn" /></span>}
					<span>· 约 {readingMinutes(post)} 分钟</span>
					{tags.length > 0 && <span>·</span>}
					{tags.map((t) => <a class="t" href={tagUrl(t)}>{t}</a>)}
				</div>
				<h1>{title}</h1>
				{summary && <p class="lead">{summary}</p>}
			</header>
			<div class="prose">
				<slot />
			</div>
			<footer class="post-foot">
				{(prev || next) && (
					<nav class="pager">
						{next ? (
							<a href={`/blog/${next.id}/`}><span>← 上一篇</span>{next.data.title}</a>
						) : <i></i>}
						{prev ? (
							<a class="right" href={`/blog/${prev.id}/`}><span>下一篇 →</span>{prev.data.title}</a>
						) : <i></i>}
					</nav>
				)}
				<a class="all" href="/blog">← 所有文章</a>
			</footer>
		</article>
		<aside>
			<div class="sticky"><Toc headings={headings} /></div>
		</aside>
	</div>
</Base>

<script>
	// 给代码块加语言标签和复制按钮
	document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
		const wrap = document.createElement('div');
		wrap.className = 'code-wrap';
		pre.replaceWith(wrap);
		wrap.append(pre);
		const lang = pre.dataset.language;
		if (lang && lang !== 'plaintext') {
			const tag = document.createElement('span');
			tag.className = 'code-lang';
			tag.textContent = lang;
			wrap.append(tag);
		}
		const btn = document.createElement('button');
		btn.className = 'code-copy';
		btn.type = 'button';
		btn.textContent = '复制';
		btn.onclick = async () => {
			await navigator.clipboard.writeText(pre.innerText);
			btn.textContent = '已复制';
			setTimeout(() => (btn.textContent = '复制'), 1500);
		};
		wrap.append(btn);
	});
</script>

<style>
	.post {
		padding-top: 64px;
	}
	.post-head {
		padding-bottom: 40px;
		margin-bottom: 40px;
		border-bottom: 1px solid var(--border);
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		font-size: 14px;
		color: var(--muted);
	}
	.t + .t::before {
		content: '·';
		margin-right: 6px;
		color: var(--muted);
	}
	h1 {
		margin: 12px 0 0;
		font-size: 36px;
		line-height: 1.3;
	}
	.lead {
		margin: 16px 0 0;
		font-size: 19px;
		line-height: 1.7;
		color: var(--muted);
	}
	.sticky {
		position: sticky;
		top: 32px;
		max-height: calc(100vh - 64px);
		overflow: auto;
	}
	aside {
		align-self: stretch;
		padding-top: 4px;
	}
	.post-foot {
		margin-top: 64px;
		padding-top: 32px;
		border-top: 1px solid var(--border);
	}
	.pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
	}
	.pager a {
		display: block;
		padding: 16px 20px;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 10px;
		font-size: 16px;
		font-weight: 600;
		color: var(--heading);
	}
	.pager a:hover {
		border-color: var(--border-strong);
		color: var(--accent);
	}
	.pager span {
		display: block;
		margin-bottom: 4px;
		font-size: 13px;
		font-weight: 400;
		color: var(--faint);
	}
	.pager .right {
		text-align: right;
	}
	.all {
		display: inline-block;
		margin-top: 24px;
		font-size: 14px;
	}
</style>
