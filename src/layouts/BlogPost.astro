---
import type { MarkdownHeading } from 'astro';
import FormattedDate from '../components/FormattedDate.astro';
import Toc from '../components/Toc.astro';
import { type Lang, t } from '../i18n';
import { type Post, postUrl, readingMinutes, summaryOf, tagUrl } from '../lib/posts';
import Base from './Base.astro';

interface Props {
	post: Post;
	lang: Lang;
	headings: MarkdownHeading[];
	prev?: Post;
	next?: Post;
	/** 另一种语言的版本地址；没有译文时为该语言的文章列表 */
	switchHref: string;
	hasAlternate: boolean;
}
const { post, lang, headings, prev, next, switchHref, hasAlternate } = Astro.props;
const { title, pubDate, updatedDate, tags } = post.data;
const summary = summaryOf(post);
const s = t(lang);
---

<Base title={title} description={summary ?? title} type="article" switchHref={switchHref} hasAlternate={hasAlternate}>
	<div class="layout post">
		<article data-copy={s.copy} data-copied={s.copied}>
			<header class="post-head">
				<div class="meta">
					<FormattedDate date={pubDate} format="long" lang={lang} />
					{updatedDate && <span>· {s.updated} <FormattedDate date={updatedDate} format="long" lang={lang} /></span>}
					<span>· {s.minutes(readingMinutes(post, lang))}</span>
					{tags.length > 0 && <span>·</span>}
					{tags.map((tag) => <a class="t" href={tagUrl(lang, tag)}>{tag}</a>)}
				</div>
				<h1>{title}</h1>
				{summary && <p class="lead">{summary}</p>}
			</header>
			<div class="prose">
				<slot />
			</div>
			<footer class="post-foot">
				{(prev || next) && (
					<nav class="pager">
						{next ? (
							<a href={postUrl(lang, next.id)}><span>{s.newer}</span>{next.data.title}</a>
						) : <i></i>}
						{prev ? (
							<a class="right" href={postUrl(lang, prev.id)}><span>{s.older}</span>{prev.data.title}</a>
						) : <i></i>}
					</nav>
				)}
				<a class="all" href={lang === 'en' ? '/en/blog' : '/blog'}>{s.backToPosts}</a>
			</footer>
		</article>
		<aside>
			<div class="sticky"><Toc headings={headings} lang={lang} /></div>
		</aside>
	</div>
</Base>

<script>
	// 给代码块加语言标签和复制按钮
	const article = document.querySelector<HTMLElement>('article[data-copy]');
	const label = article?.dataset.copy ?? 'Copy';
	const done = article?.dataset.copied ?? 'Copied';
	document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
		const wrap = document.createElement('div');
		wrap.className = 'code-wrap';
		pre.replaceWith(wrap);
		wrap.append(pre);
		const lang = pre.dataset.language;
		if (lang && lang !== 'plaintext') {
			const tag = document.createElement('span');
			tag.className = 'code-lang';
			tag.textContent = lang;
			wrap.append(tag);
		}
		const btn = document.createElement('button');
		btn.className = 'code-copy';
		btn.type = 'button';
		btn.textContent = label;
		btn.onclick = async () => {
			await navigator.clipboard.writeText(pre.innerText);
			btn.textContent = done;
			setTimeout(() => (btn.textContent = label), 1500);
		};
		wrap.append(btn);
	});
</script>

<style>
	.post {
		padding-top: 64px;
	}
	.post-head {
		padding-bottom: 40px;
		margin-bottom: 40px;
		border-bottom: 1px solid var(--border);
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		font-size: 14px;
		color: var(--muted);
	}
	.t + .t::before {
		content: '·';
		margin-right: 6px;
		color: var(--muted);
	}
	h1 {
		margin: 12px 0 0;
		font-size: 36px;
		line-height: 1.3;
	}
	.lead {
		margin: 16px 0 0;
		font-size: 19px;
		line-height: 1.7;
		color: var(--muted);
	}
	.sticky {
		position: sticky;
		top: 32px;
		max-height: calc(100vh - 64px);
		overflow: auto;
	}
	aside {
		align-self: stretch;
		padding-top: 4px;
	}
	.post-foot {
		margin-top: 64px;
		padding-top: 32px;
		border-top: 1px solid var(--border);
	}
	.pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
	}
	.pager a {
		display: block;
		padding: 16px 20px;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 10px;
		font-size: 16px;
		font-weight: 600;
		color: var(--heading);
	}
	.pager a:hover {
		border-color: var(--border-strong);
		color: var(--accent);
	}
	.pager span {
		display: block;
		margin-bottom: 4px;
		font-size: 13px;
		font-weight: 400;
		color: var(--faint);
	}
	.pager .right {
		text-align: right;
	}
	.all {
		display: inline-block;
		margin-top: 24px;
		font-size: 14px;
	}
</style>
