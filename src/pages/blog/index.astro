---
import PostItem from '../../components/PostItem.astro';
import TagList from '../../components/TagList.astro';
import Rss from '../../components/icons/Rss.astro';
import { SITE_DESCRIPTION } from '../../consts';
import Base from '../../layouts/Base.astro';
import { getAllTags, getPosts } from '../../lib/posts';

const posts = await getPosts();
const tags = getAllTags(posts);
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
	const y = post.data.pubDate.getUTCFullYear();
	byYear.set(y, [...(byYear.get(y) ?? []), post]);
}
const years = [...byYear.keys()];
---

<Base title="文章" description={SITE_DESCRIPTION}>
	<header class="page-head">
		<h1>文章</h1>
		<p>共 {posts.length} 篇 · {years.at(-1)} – {years[0]}</p>
	</header>
	<div class="layout">
		<section>
			{[...byYear].map(([year, list]) => (
				<div class="year-group">
					<div class="year">{year}</div>
					<div>{list.map((post) => <PostItem post={post} dateFormat="md" />)}</div>
				</div>
			))}
		</section>
		<aside>
			<div class="side-block">
				<h2 class="side-title">标签</h2>
				<TagList tags={tags} />
			</div>
			<div class="side-block">
				<a class="rss" href="/rss.xml"><Rss /> RSS 订阅</a>
			</div>
		</aside>
	</div>
</Base>
<style>
	.year-group {
		display: grid;
		grid-template-columns: 96px 1fr;
	}
	.year {
		position: sticky;
		top: 24px;
		align-self: start;
		padding-top: 22px;
		font-size: 20px;
		font-weight: 600;
		color: var(--faint);
		font-variant-numeric: tabular-nums;
	}
	.rss {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 14px;
	}
</style>
