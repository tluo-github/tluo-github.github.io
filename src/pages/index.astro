---
import PostItem from '../components/PostItem.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TagList from '../components/TagList.astro';
import { AUTHOR, GITHUB_URL, INTRO, LOCATION, MOTTO, PROJECTS, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Base from '../layouts/Base.astro';
import { getAllTags, getPosts } from '../lib/posts';

const posts = await getPosts();
const tags = getAllTags(posts);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero">
		<img src="/avatar.jpg" alt={AUTHOR} width="112" height="112" />
		<div>
			<h1>你好，我是 {AUTHOR}</h1>
			<p class="role">{INTRO}</p>
			<div class="line">
				<span class="motto">{MOTTO} · 坐标{LOCATION}</span>
				<span class="links">
					<a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>
					<a href="/rss.xml">RSS</a>
					<a href="/about">关于我</a>
				</span>
			</div>
		</div>
	</section>

	<div class="layout">
		<section>
			<h2 class="side-title">最近文章</h2>
			{posts.slice(0, 10).map((post) => <PostItem post={post} />)}
			<a class="more" href="/blog">全部文章 →</a>
		</section>
		<aside>
			<div class="side-block">
				<h2 class="side-title">项目</h2>
				{PROJECTS.slice(0, 4).map((p) => <ProjectCard {...p} compact />)}
				<a class="more" href="/projects">全部项目 →</a>
			</div>
			<div class="side-block">
				<h2 class="side-title">标签</h2>
				<TagList tags={tags} />
			</div>
		</aside>
	</div>
</Base>
<style>
	.hero {
		display: flex;
		align-items: center;
		gap: 32px;
		padding: 72px 0 56px;
		margin-bottom: 40px;
		border-bottom: 1px solid var(--border);
	}
	.hero img {
		flex: none;
		border-radius: 50%;
		border: 1px solid var(--border);
	}
	h1 {
		margin: 0;
		font-size: 36px;
		line-height: 1.3;
	}
	.role {
		margin: 8px 0 0;
		font-size: 18px;
	}
	.line {
		display: flex;
		align-items: center;
		gap: 32px;
		margin-top: 10px;
	}
	.motto {
		font-size: 15px;
		color: var(--muted);
		padding-left: 12px;
		border-left: 3px solid var(--accent);
		line-height: 1.1;
	}
	.links {
		display: flex;
		gap: 20px;
		font-size: 14px;
	}
	aside {
		padding-top: 0;
	}
</style>
