---
import ProjectCard from '../components/ProjectCard.astro';
import { GITHUB_URL, PROJECT_GROUPS, PROJECTS } from '../consts';
import Base from '../layouts/Base.astro';
---

<Base title="项目" description="我做的一些开源项目">
	<header class="page-head">
		<h1>项目</h1>
		<p>一些开源项目，更多见 <a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>。</p>
	</header>
	{PROJECT_GROUPS.map((g) => (
		<section class="group">
			<div class="group-head">
				<h2>{g.title}</h2>
				<p>{g.desc}</p>
			</div>
			<div class="grid">
				{PROJECTS.filter((p) => p.group === g.key).map((p) => <ProjectCard {...p} />)}
			</div>
		</section>
	))}
</Base>
<style>
	.group + .group {
		margin-top: 56px;
	}
	.group-head {
		display: flex;
		align-items: baseline;
		gap: 16px;
		margin-bottom: 20px;
	}
	h2 {
		margin: 0;
		font-size: 20px;
	}
	.group-head p {
		margin: 0;
		font-size: 14px;
		color: var(--muted);
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}
</style>
