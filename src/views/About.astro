---
import GitHub from '../components/icons/GitHub.astro';
import Rss from '../components/icons/Rss.astro';
import { AUTHOR, GITHUB_URL, SITE } from '../consts';
import { type Lang, t, url } from '../i18n';
import Base from '../layouts/Base.astro';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const site = SITE[lang];
const zh = lang === 'zh';
const post = (id: string) => url(lang, `/blog/${id}/`);

const career = zh
	? [
			{ time: '2025 –', title: 'AI Vibe Coding 独立开发', desc: '用 Claude Code、Codex 等 AI 编程工具，从想法到上线独立做产品。' },
			{
				time: '2021 – 2025',
				title: '得物 · 高级 SRE 工程师',
				desc: '负责 20 套、2000+ 节点、10 万+ Pod 的阿里云 ACK 生产集群，保障算法域搜推核心链路 SLA 99.95%。',
			},
			{
				time: '2017 – 2021',
				title: '金融科技公司 · 软件工程师（派驻银行网银公共平台组）',
				desc: '做 DevOps 平台、K8s 集群运维、ELK 日志与 APM 监控平台，参与 1000+ 微服务的容器化改造。',
			},
		]
	: [
			{
				time: '2025 –',
				title: 'Independent developer, AI vibe coding',
				desc: 'Building products end to end with AI coding tools such as Claude Code and Codex.',
			},
			{
				time: '2021 – 2025',
				title: 'Dewu (Poizon) · Senior SRE',
				desc: 'Ran 20 production Kubernetes clusters on Alibaba Cloud ACK (2,000+ nodes, 100k+ pods) and kept the search & recommendation core path at 99.95% SLA.',
			},
			{
				time: '2017 – 2021',
				title: 'Fintech company · Software engineer (on site at a bank’s online-banking platform team)',
				desc: 'Built the DevOps platform, ran Kubernetes clusters, the ELK logging and APM monitoring platforms, and helped containerize 1,000+ microservices.',
			},
		];

const stack = zh
	? [
			['语言', 'Java、Go、Python、C、Shell'],
			['云原生', 'Kubernetes（调度器、CRD / Operator、Device Plugin、Admission Webhook）、Docker、Helm、GitLab CI/CD'],
			['可观测', 'Prometheus、Grafana、ELK、SkyWalking、OnCall 与 SLO 体系'],
			['中间件', 'ZooKeeper、Elasticsearch、Kafka、RocketMQ、Redis、MySQL、Dubbo'],
			['AI', 'Claude Code、Cursor、Dify、LangChain、vLLM / SGLang、Milvus'],
		]
	: [
			['Languages', 'Java, Go, Python, C, Shell'],
			['Cloud native', 'Kubernetes (scheduler, CRD / Operator, Device Plugin, admission webhooks), Docker, Helm, GitLab CI/CD'],
			['Observability', 'Prometheus, Grafana, ELK, SkyWalking, on-call and SLOs'],
			['Middleware', 'ZooKeeper, Elasticsearch, Kafka, RocketMQ, Redis, MySQL, Dubbo'],
			['AI', 'Claude Code, Cursor, Dify, LangChain, vLLM / SGLang, Milvus'],
		];
---

<Base title={s.about} description={`${s.about} ${AUTHOR}: ${site.role}`}>
	<header class="page-head">
		<h1>{s.about}</h1>
	</header>
	<div class="layout">
		<div class="prose">
			{zh ? (
				<Fragment>
					<p>
						你好，我是 {AUTHOR}，在{site.location}。现在主要做 <strong>AI Vibe Coding</strong>：用 AI 编程工具把想法直接做成产品，比如在菜单栏查看
						AI 编程工具用量的 <a href="https://quotlet.com" target="_blank" rel="noopener">quotlet</a>，和极简 Markdown 阅读器
						<a href="https://github.com/tluo-github/markread" target="_blank" rel="noopener">markread</a>。
					</p>
					<p>
						在这之前，我做了 8 年多 Java 后端和云原生基础设施，关注分布式系统里那些“平时不出事、一出事就很难查”的问题：调度、负载均衡、GC
						停顿、容器网络、中间件性能。这些经验现在也成了我用 AI 做产品时的底气：知道系统会在哪里出问题。
					</p>
				</Fragment>
			) : (
				<Fragment>
					<p>
						Hi, I'm {AUTHOR}, based in {site.location}. These days I mostly do <strong>AI vibe coding</strong>: turning ideas straight into products
						with AI coding tools. Examples include <a href="https://quotlet.com" target="_blank" rel="noopener">quotlet</a>, a menu bar app that
						tracks AI coding tool usage, and <a href="https://github.com/tluo-github/markread" target="_blank" rel="noopener">markread</a>, a
						minimal Markdown reader.
					</p>
					<p>
						Before that, I spent 8+ years on Java backends and cloud-native infrastructure, working on the problems in distributed systems that
						are quiet most of the time and painful to debug when they break: scheduling, load balancing, GC pauses, container networking and
						middleware performance. That experience is what I lean on when building with AI: I know where systems tend to fail.
					</p>
				</Fragment>
			)}

			<h2>{zh ? '经历' : 'Experience'}</h2>
			<ol class="timeline">
				{career.map((c) => (
					<li>
						<span class="time">{c.time}</span>
						<div>
							<div class="t">{c.title}</div>
							<div class="d">{c.desc}</div>
						</div>
					</li>
				))}
			</ol>

			<h2>{zh ? '做过的一些事' : 'Selected work'}</h2>
			{zh ? (
				<ul>
					<li><strong>负载感知调度器</strong>：基于 Scheduler Framework 定制 K8s 调度器，用应用 24 小时 CPU 画像做方差调度，让峰值负载错峰打散，集群峰值资源利用率降低 10%。</li>
					<li><strong>声明式运维控制面 WatchDog</strong>：用 Go 实现一套对标 kube-controller-manager 的控制面（声明式 API、Informer / Reconciler、Leader 选举、灰度发布），统一管理跨集群运维插件的分发和生命周期。</li>
					<li><strong>Dubbo 柔性负载均衡</strong>：基于 EMA 实时感知 RT 动态调权，在搜推链路落地，RT 异常波动降低 10%，见<a href={post('dubbo-flexible-scheduling')}>《dubbo 柔性调度》</a>。</li>
					<li><strong>容器网络排障</strong>：历时两个月，定位阿里云 CNI 与神龙网卡丢包导致 Flink 吞吐偶发跌零的根因。</li>
					<li><strong>ZooKeeper 内核调优</strong>：针对亿级 Watch 场景做源码级优化，集群吞吐提升 10 倍。</li>
					<li><strong>JVM 诊断工具链</strong>：GC 日志分析器（覆盖 6 类回收器、JDK 1.4–21）、Heap Dump 二进制解析、基于 JVMTI 的 C 语言诊断 Agent。相关文章见<a href={post('zgc')}>《ZGC 亚毫秒级延迟 GC》</a>。</li>
					<li><strong>AI 基础设施</strong>：设计 LLM 网关统一接入各家大模型；用 Dify + LangChain 搭 SRE 运维知识库（RAG），平均 MTTR 缩短 20%。</li>
					<li><strong>DevOps 构建引擎</strong>：用 Go 自研，支撑 1000+ 应用每日 10 万次构建，比原生 GitLab CI 快 50%。</li>
				</ul>
			) : (
				<ul>
					<li><strong>Load-aware scheduler</strong>: a custom Kubernetes scheduler built on the Scheduler Framework. It uses each app’s 24-hour CPU profile for variance-based scheduling, spreading peaks apart and cutting cluster peak resource utilization by 10%.</li>
					<li><strong>WatchDog, a declarative ops control plane</strong>: written in Go and modeled on kube-controller-manager (declarative API, informer / reconciler, leader election, rolling updates). It manages the rollout and lifecycle of ops agents across clusters.</li>
					<li><strong>Adaptive load balancing for Dubbo</strong>: weights follow live RT via EMA. In production on the search & recommendation path it cut RT spikes by 10%. See <a href={post('dubbo-flexible-scheduling')}>Adaptive Load Balancing for Dubbo</a>.</li>
					<li><strong>Container network debugging</strong>: a two-month hunt that traced intermittent zero throughput in Flink jobs to packet loss between Alibaba Cloud’s CNI and its bare-metal NICs.</li>
					<li><strong>ZooKeeper internals</strong>: source-level tuning for a workload with hundreds of millions of watches, raising cluster throughput 10×.</li>
					<li><strong>JVM diagnostics toolkit</strong>: a GC log analyzer (6 collectors, JDK 1.4–21), a binary heap dump parser, and a JVMTI-based diagnostic agent in C. Related post: <a href={post('zgc')}>ZGC: Sub-millisecond GC Pauses</a>.</li>
					<li><strong>AI infrastructure</strong>: designed an LLM gateway in front of all major model providers, and built an SRE knowledge base (RAG) with Dify + LangChain that cut mean time to recovery by 20%.</li>
					<li><strong>DevOps build engine</strong>: built in Go, running 100k builds a day for 1,000+ apps, 50% faster than stock GitLab CI.</li>
				</ul>
			)}

			<h2>{zh ? '技术栈' : 'Tech stack'}</h2>
			<dl class="stack">
				{stack.map(([k, v]) => (
					<>
						<dt>{k}</dt>
						<dd>{v}</dd>
					</>
				))}
			</dl>

			<h2>{zh ? '这个博客' : 'About this blog'}</h2>
			<p>
				{zh
					? '写两类东西：用 AI 做产品的过程和心得，以及过去在一线踩过、查过、解决过的问题。欢迎通过 GitHub 交流。'
					: 'I write about two things here: building products with AI, and production problems I have hit, debugged and fixed. Feel free to reach out on GitHub.'}
			</p>
		</div>
		<aside class="card">
			<img src="/avatar.jpg" alt={AUTHOR} width="160" height="160" />
			<div class="name">{AUTHOR}</div>
			<div class="role">{site.role}</div>
			<div class="role">{site.location}</div>
			<div class="motto">{site.motto}</div>
			<ul>
				<li><GitHub /><a href={GITHUB_URL} target="_blank" rel="noopener">@tluo-github</a></li>
				<li>
					<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0M2.04 7a6 6 0 0 1 3.03-4.6A12 12 0 0 0 4.02 7zm0 2h1.98a12 12 0 0 0 1.05 4.6A6 6 0 0 1 2.04 9M8 13.9C7.2 13 6.2 11.4 6.03 9h3.94C9.8 11.4 8.8 13 8 13.9M6.03 7C6.2 4.6 7.2 3 8 2.1 8.8 3 9.8 4.6 9.97 7zm4.9 6.6A12 12 0 0 0 11.98 9h1.98a6 6 0 0 1-3.03 4.6M11.98 7a12 12 0 0 0-1.05-4.6A6 6 0 0 1 13.96 7z"></path></svg>
					<a href="https://quotlet.com" target="_blank" rel="noopener">quotlet.com</a>
				</li>
				<li><Rss /><a href={url(lang, '/rss.xml')}>{s.rss}</a></li>
			</ul>
		</aside>
	</div>
</Base>
<style>
	.timeline {
		list-style: none;
		padding: 0;
		margin: 0 0 20px;
	}
	.timeline li {
		display: grid;
		grid-template-columns: 120px 1fr;
		gap: 16px;
		padding: 14px 0;
		border-bottom: 1px solid var(--border);
	}
	.timeline li + li {
		margin-top: 0;
	}
	.time {
		font-size: 15px;
		color: var(--faint);
		font-variant-numeric: tabular-nums;
		padding-top: 2px;
	}
	.timeline .t {
		font-weight: 600;
		color: var(--heading);
	}
	.timeline .d {
		margin-top: 2px;
		font-size: 16px;
		color: var(--muted);
	}
	.stack {
		display: grid;
		grid-template-columns: 80px 1fr;
		gap: 10px 16px;
		margin: 0 0 20px;
		font-size: 16px;
	}
	.stack dt {
		font-weight: 600;
		color: var(--heading);
	}
	.stack dd {
		margin: 0;
	}
	.card {
		position: sticky;
		top: 32px;
		padding: 24px;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 12px;
	}
	.card img {
		display: block;
		border-radius: 12px;
	}
	.name {
		margin-top: 16px;
		font-size: 20px;
		font-weight: 700;
		color: var(--heading);
	}
	.role {
		font-size: 14px;
		color: var(--muted);
	}
	.motto {
		margin: 16px 0;
		padding-left: 12px;
		border-left: 3px solid var(--accent);
		font-size: 17px;
		line-height: 1.3;
		color: var(--heading);
	}
	.card ul {
		list-style: none;
		margin: 0;
		padding: 16px 0 0;
		border-top: 1px solid var(--border);
		font-size: 14px;
	}
	.card li {
		display: flex;
		align-items: center;
		gap: 8px;
		color: var(--muted);
	}
	.card li + li {
		margin-top: 8px;
	}
</style>
