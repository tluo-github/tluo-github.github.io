---
import PostItem from '../components/PostItem.astro';
import TagList from '../components/TagList.astro';
import Rss from '../components/icons/Rss.astro';
import { SITE } from '../consts';
import { type Lang, t, url } from '../i18n';
import Base from '../layouts/Base.astro';
import { getAllTags, getPostList, getPosts, type PostRef } from '../lib/posts';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const items = await getPostList(lang);
const tags = getAllTags(await getPosts(lang));
const byYear = new Map<number, PostRef[]>();
for (const item of items) {
	const y = item.post.data.pubDate.getUTCFullYear();
	byYear.set(y, [...(byYear.get(y) ?? []), item]);
}
const years = [...byYear.keys()];
---

<Base title={s.posts} description={SITE[lang].description}>
	<header class="page-head">
		<h1>{s.posts}</h1>
		<p>{s.postCount(items.length, years.at(-1), years[0])}</p>
	</header>
	<div class="layout">
		<section>
			{[...byYear].map(([year, list]) => (
				<div class="year-group">
					<div class="year">{year}</div>
					<div>{list.map((item) => <PostItem item={item} lang={lang} dateFormat="md" />)}</div>
				</div>
			))}
		</section>
		<aside>
			<div class="side-block">
				<h2 class="side-title">{s.tags}</h2>
				<TagList tags={tags} lang={lang} />
			</div>
			<div class="side-block">
				<a class="rss" href={url(lang, '/rss.xml')}><Rss /> {s.rss}</a>
			</div>
		</aside>
	</div>
</Base>
<style>
	.year-group {
		display: grid;
		grid-template-columns: 96px 1fr;
	}
	.year {
		position: sticky;
		top: 24px;
		align-self: start;
		padding-top: 22px;
		font-size: 20px;
		font-weight: 600;
		color: var(--faint);
		font-variant-numeric: tabular-nums;
	}
	.rss {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 14px;
	}
</style>
